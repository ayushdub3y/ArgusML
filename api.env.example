# ArgusML Environment Configuration
# Copy this file to api.env and fill in real values.

# Razorpay Test-Mode API Credentials (for real Disputes API calls)
# Obtain from https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXX

# Razorpay Webhook Secret (for HMAC-SHA256 signature verification)
RAZORPAY_WEBHOOK_SECRET=

# LLM Provider for Model B Evidence Assembler (Google Gemini API via google-genai SDK)
# Optional — gracefully falls back to deterministic drafting if unset
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Dashboard Authentication (optional — fail-open for local demo)
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
